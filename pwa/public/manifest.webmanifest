{
    "name": "Stickvania",
    "short_name": "Stickvania",
    "description": "A browser PWA port of Stickvania.",
    "id": "/stickvania",
    "start_url": "./",
    "scope": ".",
    "display": "standalone",
    "orientation": "landscape",
    "background_color": "#000000",
    "theme_color": "#000000",
    "icons": [
        {
            "src": "images/icon.png?v=%ASSET_VERSION(images/icon.png)%",
            "sizes": "32x32",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "images/icon-192.png?v=%ASSET_VERSION(images/icon-192.png)%",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "images/icon-512.png?v=%ASSET_VERSION(images/icon-512.png)%",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "images/icon-maskable.svg?v=%ASSET_VERSION(images/icon-maskable.svg)%",
            "sizes": "512x512",
            "type": "image/svg+xml",
            "purpose": "maskable"
        }
    ]
}
