{
    "name": "stickvania-js",
    "version": "1.0.0",
    "private": true,
    "homepage": "https://meatfighter.com/stickvania/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/meatfighter/stickvania-js.git"
    },
    "license": "SEE LICENSE IN COPYRIGHT.md",
    "type": "module",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "scripts": {
        "stamp": "node scripts/stamp.mjs",
        "clean": "node scripts/clean-dist.mjs",
        "format": "prettier . --write --ignore-unknown",
        "format:check": "prettier . --check --ignore-unknown",
        "dev": "npm run dev:pwa",
        "dev:pwa": "vite --config pwa/vite.config.ts --host 127.0.0.1",
        "build:pwa": "npm run build:pwa:release",
        "build:pwa:release": "node scripts/run-stamped-release.mjs --dist .release-components/pwa --clean-dist _build:pwa:release",
        "_build:pwa:release": "npm run check:resource-versions && tsc --project pwa/tsconfig.json && vite build --config pwa/vite.config.ts",
        "build:about": "node scripts/run-stamped-release.mjs --dist .release-components/about --clean-dist _build:about",
        "_build:about": "node scripts/build-about.mjs",
        "build:desktop": "node scripts/build-desktop.mjs",
        "_assemble": "node scripts/assemble.mjs",
        "build:web": "node scripts/run-stamped-release.mjs --dist .release-components/web --clean-dist _build:pwa:release _build:about build:desktop _assemble verify:desktop-release",
        "build": "node scripts/build-production.mjs",
        "typecheck": "tsc --project pwa/tsconfig.json",
        "lint": "eslint \"pwa/src/**/*.ts\" \"pwa/vite.config.ts\" \"pwa/public/sw.js\"",
        "generate:state-fields": "node scripts/generate-state-field-registry.mjs",
        "check:state-fields": "node scripts/generate-state-field-registry.mjs --check",
        "test:axe-knight-shield": "node scripts/test-axe-knight-shield.mjs && node scripts/test-axe-knight-shield-ping-pong.mjs && node scripts/test-axe-knight-shield-post-death.mjs && node scripts/test-axe-knight-shield-persistence.mjs",
        "test:gameplay-transition-hardening": "node scripts/test-stage-clear-action-preservation.mjs && node scripts/test-stage-clear-stopwatch.mjs && node scripts/test-timeout-pit-death.mjs",
        "test:demo-audio-retirement": "node scripts/test-demo-audio-retirement.mjs",
        "test:production-promotion-cleanup": "node scripts/test-production-promotion-cleanup.mjs",
        "test:about-page": "node scripts/test-about-page.mjs",
        "test:about-html": "node --test scripts/test-about-html.mjs",
        "_verify:pwa-release": "node scripts/verify-pwa-release.mjs",
        "verify:pwa-install-metadata": "node scripts/verify-pwa-install-metadata.mjs",
        "test:pwa-release": "node scripts/run-stamped-release.mjs --dist .release-components/pwa-test --clean-dist _build:pwa:release _verify:pwa-release",
        "test:pwa-state-hardening": "node scripts/test-pwa-state-hardening.mjs && node scripts/test-state-field-value-policy.mjs",
        "test:pwa-audio-persistence": "node scripts/test-game-state-audio-persistence.mjs",
        "test:pwa-machinery-hardening": "node scripts/test-pwa-machinery-hardening.mjs",
        "test:stopwatch-hardening": "node scripts/test-stopwatch-hardening.mjs && node scripts/test-stopwatch-repeat-runtime.mjs && node scripts/test-stopwatch-boss-freeze.mjs && node scripts/test-stopwatch-timer-freeze.mjs && node scripts/test-dracula-post-death-stopwatch-state.mjs && node scripts/test-stage-three-floor-breaking-actions.mjs",
        "verify:desktop-source": "node scripts/verify-desktop-source.mjs",
        "verify:desktop-release": "node scripts/verify-desktop-release.mjs",
        "verify:release-tooling": "node scripts/verify-release-tooling.mjs",
        "verify:dependencies": "npm audit --audit-level=high",
        "verify": "node --test scripts/test-slick-install-cutover.mjs && node --test scripts/test-deployment-scope-cutover.mjs && node --test scripts/test-cutover-browser-script-syntax.mjs && node --test scripts/test-playback-session.mjs && node --test scripts/test-browser-haptics.mjs && node --test scripts/test-browser-fullscreen-controls.mjs && node --test scripts/test-pwa-menu-touch-zoom.mjs && npm run test:rumble-session && node --test scripts/test-service-worker-deadline.mjs && node --test scripts/test-pwa-manifest-identity.mjs && npm run test:session-ownership && npm run format:check && npm run lint && npm run check:resource-versions && npm run check:java-parity-metadata && npm run check:state-fields && npm run test:axe-knight-shield && npm run test:gameplay-transition-hardening && npm run test:demo-audio-retirement && npm run test:production-promotion-cleanup && npm run test:pwa-state-hardening && npm run test:pwa-audio-persistence && npm run test:pwa-machinery-hardening && npm run test:stopwatch-hardening && npm run test:buffered-scaling-wiring && npm run test:java-parity && npm run test:typescript-tech-debt && npm run test:about-page && npm run test:about-html && npm run verify:release-tooling && npm run test:pwa-release && npm run verify:desktop-source && npm run build:desktop",
        "verify:browser": "node scripts/run-browser-verification.mjs && node scripts/run-offline-verification.mjs",
        "release": "npm run verify && npm run verify:dependencies && npm run build",
        "qualify": "node scripts/assert-clean-git.mjs && npm run release && npm run verify:browser && node scripts/assert-clean-git.mjs",
        "qualify:browsers": "node scripts/run-browser-qualification-suite.mjs",
        "preview": "npm run preview:pwa",
        "preview:pwa": "vite preview --config pwa/vite.config.ts --host 127.0.0.1",
        "preview:dist": "vite preview --host 127.0.0.1 --outDir dist",
        "release:desktop": "node scripts/release-desktop.mjs",
        "run:desktop": "node scripts/run-desktop.mjs",
        "test:buffered-scaling-wiring": "node scripts/test-buffered-scaling-wiring.mjs",
        "test:java-parity": "node scripts/test-java-parity.mjs",
        "generate:resource-versions": "node scripts/generate-resource-versions.mjs",
        "check:resource-versions": "node scripts/generate-resource-versions.mjs --check",
        "generate:java-parity-metadata": "node scripts/generate-java-parity-metadata.mjs",
        "check:java-parity-metadata": "node scripts/generate-java-parity-metadata.mjs --check",
        "test:typescript-tech-debt": "node scripts/test-typescript-tech-debt-guardrails.mjs",
        "test:session-ownership": "node --test scripts/test-session-ownership.mjs",
        "test:rumble-session": "node --test scripts/test-rumble-session.mjs",
        "verify:fullscreen": "node scripts/run-fullscreen-qualification.mjs",
        "verify:fullscreen-timeout": "node scripts/run-fullscreen-timeout-qualification.mjs",
        "verify:fullscreen-reentry": "node scripts/run-fullscreen-reentry-qualification.mjs",
        "verify:fullscreen-settings": "node scripts/run-fullscreen-settings-qualification.mjs",
        "verify:production-browser": "node scripts/run-production-browser-qualification.mjs",
        "verify:activation-races": "node scripts/run-activation-race-qualification.mjs",
        "verify:audio-interruption": "node scripts/run-audio-interruption-qualification.mjs",
        "verify:lifecycle-events": "node scripts/run-lifecycle-event-qualification.mjs",
        "verify:ownership-transfer": "node scripts/run-ownership-transfer-qualification.mjs",
        "verify:persistence-failure": "node scripts/run-persistence-failure-qualification.mjs",
        "verify:lifecycle-stress": "node scripts/run-lifecycle-stress-qualification.mjs",
        "release:archive": "node scripts/archive-release.mjs"
    },
    "dependencies": {
        "slick2d-ts": "https://codeload.github.com/meatfighter/slick2d-ts/tar.gz/55332709786a2657e5231b1fd5ea0963097a4534"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.5.1",
        "eslint": "^10.10.0",
        "playwright": "1.63.0",
        "prettier": "^3.9.6",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.3.0"
    }
}
