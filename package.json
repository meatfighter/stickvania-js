{
    "name": "stickvania-js",
    "version": "1.0.0",
    "private": true,
    "homepage": "https://meatfighter.com/stickvania/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/meatfighter/stickvania-js.git"
    },
    "license": "GPL-3.0-or-later",
    "type": "module",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "scripts": {
        "stamp": "node scripts/stamp.mjs",
        "clean": "node scripts/clean-dist.mjs",
        "format": "prettier . --write --ignore-unknown",
        "format:check": "prettier . --check --ignore-unknown",
        "dev": "npm run dev:pwa",
        "dev:pwa": "vite --config pwa/vite.config.ts --host 127.0.0.1",
        "build:pwa": "npm run build:pwa:release",
        "build:pwa:release": "node scripts/run-stamped-release.mjs --dist .release-components/pwa --clean-dist _build:pwa:release",
        "_build:pwa:release": "npm run check:resource-versions && tsc --project pwa/tsconfig.json && vite build --config pwa/vite.config.ts",
        "build:about": "node scripts/run-stamped-release.mjs --dist .release-components/about --clean-dist _build:about",
        "_build:about": "node scripts/build-about.mjs",
        "build:desktop": "node scripts/build-desktop.mjs",
        "_assemble": "node scripts/assemble.mjs",
        "build:web": "node scripts/run-stamped-release.mjs --dist .release-components/web --clean-dist _build:pwa:release _build:about build:desktop _assemble verify:desktop-release",
        "build": "node scripts/build-production.mjs",
        "typecheck": "tsc --project pwa/tsconfig.json",
        "lint": "eslint \"pwa/src/**/*.ts\" \"pwa/vite.config.ts\" \"pwa/public/sw.js\"",
        "generate:state-fields": "node scripts/generate-state-field-registry.mjs",
        "check:state-fields": "node scripts/generate-state-field-registry.mjs --check",
        "test:about-page": "node scripts/test-about-page.mjs",
        "test:about-html": "node --test scripts/test-about-html.mjs",
        "_verify:pwa-release": "node scripts/verify-pwa-release.mjs",
        "verify:pwa-install-metadata": "node scripts/verify-pwa-install-metadata.mjs",
        "test:pwa-release": "node scripts/run-stamped-release.mjs --dist .release-components/pwa-test --clean-dist _build:pwa:release _verify:pwa-release",
        "test:pwa-state-hardening": "node scripts/test-pwa-state-hardening.mjs",
        "test:pwa-machinery-hardening": "node scripts/test-pwa-machinery-hardening.mjs",
        "verify:desktop-source": "node scripts/verify-desktop-source.mjs",
        "verify:desktop-release": "node scripts/verify-desktop-release.mjs",
        "verify:release-tooling": "node scripts/verify-release-tooling.mjs",
        "verify:dependencies": "npm audit --audit-level=high",
        "verify": "node --test scripts/test-audio-unlock.mjs && node --test scripts/test-service-worker-deadline.mjs && node --test scripts/test-pwa-manifest-identity.mjs && npm run test:session-ownership && npm run format:check && npm run lint && npm run check:resource-versions && npm run check:java-parity-metadata && npm run check:state-fields && npm run test:pwa-state-hardening && npm run test:pwa-machinery-hardening && npm run test:buffered-scaling-wiring && npm run test:java-parity && npm run test:typescript-tech-debt && npm run test:about-page && npm run test:about-html && npm run verify:release-tooling && npm run test:pwa-release && npm run verify:desktop-source && npm run build:desktop",
        "verify:browser": "node scripts/run-browser-verification.mjs && node scripts/run-offline-verification.mjs",
        "release": "npm run verify && npm run verify:dependencies && npm run build",
        "qualify": "node scripts/assert-clean-git.mjs && npm run release && npm run verify:browser && node scripts/assert-clean-git.mjs",
        "qualify:browsers": "npm run verify:production-browser",
        "preview": "npm run preview:pwa",
        "preview:pwa": "vite preview --config pwa/vite.config.ts --host 127.0.0.1",
        "preview:dist": "vite preview --host 127.0.0.1 --outDir dist",
        "release:desktop": "node scripts/release-desktop.mjs",
        "run:desktop": "node scripts/run-desktop.mjs",
        "test:buffered-scaling-wiring": "node scripts/test-buffered-scaling-wiring.mjs",
        "test:java-parity": "node scripts/test-java-parity.mjs",
        "generate:resource-versions": "node scripts/generate-resource-versions.mjs",
        "check:resource-versions": "node scripts/generate-resource-versions.mjs --check",
        "generate:java-parity-metadata": "node scripts/generate-java-parity-metadata.mjs",
        "check:java-parity-metadata": "node scripts/generate-java-parity-metadata.mjs --check",
        "test:typescript-tech-debt": "node scripts/test-typescript-tech-debt-guardrails.mjs",
        "test:session-ownership": "node --test scripts/test-session-ownership.mjs",
        "verify:production-browser": "node scripts/run-production-browser-qualification.mjs",
        "release:archive": "node scripts/archive-release.mjs"
    },
    "dependencies": {
        "slick2d-ts": "https://codeload.github.com/meatfighter/slick2d-ts/tar.gz/962be7001549b4f2b96519dc4625447f05e0aeee"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.1.2",
        "eslint": "^10.8.0",
        "playwright": "1.63.0",
        "prettier": "^3.9.6",
        "typescript": "^5.9.0",
        "typescript-eslint": "^8.65.0",
        "vite": "^7.0.0"
    }
}
