{
    "name": "stickvania-js",
    "version": "1.0.0",
    "private": true,
    "license": "GPL-3.0-or-later",
    "type": "module",
    "scripts": {
        "stamp": "node scripts/stamp.mjs",
        "clean": "node scripts/clean-dist.mjs",
        "format": "prettier . --write --ignore-unknown",
        "format:check": "prettier . --check --ignore-unknown",
        "dev": "npm run dev:pwa",
        "dev:pwa": "vite --config pwa/vite.config.ts --host 127.0.0.1",
        "build:pwa": "npm run build:pwa:release",
        "build:pwa:release": "node scripts/run-stamped-release.mjs --dist .release-components/pwa --clean-dist _build:pwa:release",
        "_build:pwa:release": "tsc --project pwa/tsconfig.json && vite build --config pwa/vite.config.ts",
        "build:about": "node scripts/run-stamped-release.mjs --dist .release-components/about --clean-dist _build:about",
        "_build:about": "node scripts/build-about.mjs",
        "build:desktop": "node scripts/build-desktop.mjs",
        "_assemble": "node scripts/assemble.mjs",
        "build:web": "node scripts/run-stamped-release.mjs --dist .release-components/web --clean-dist _build:pwa:release _build:about",
        "build": "node scripts/build-production.mjs",
        "typecheck": "tsc --project pwa/tsconfig.json",
        "lint": "eslint \"pwa/src/**/*.ts\" \"pwa/vite.config.ts\" \"pwa/public/sw.js\"",
        "_verify:pwa-release": "node scripts/verify-pwa-release.mjs",
        "test:pwa-release": "node scripts/run-stamped-release.mjs --dist .release-components/pwa-test --clean-dist _build:pwa:release _verify:pwa-release",
        "verify:desktop-release": "node scripts/verify-desktop-release.mjs",
        "verify:release-tooling": "node scripts/verify-release-tooling.mjs",
        "verify": "npm run format:check && npm run lint && npm run verify:release-tooling && npm run test:pwa-release && npm run build:desktop",
        "preview": "npm run preview:pwa",
        "preview:pwa": "vite preview --config pwa/vite.config.ts --host 127.0.0.1",
        "preview:dist": "vite preview --host 127.0.0.1 --outDir dist",
        "release:desktop": "npm run verify && node scripts/copy-desktop-release.mjs",
        "run:desktop": "node scripts/run-desktop.mjs"
    },
    "dependencies": {
        "slick2d-ts": "git+https://github.com/meatfighter/slick2d-ts.git#semver:^1.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.1.2",
        "eslint": "^10.8.0",
        "prettier": "^3.9.6",
        "typescript": "^5.9.0",
        "typescript-eslint": "^8.65.0",
        "vite": "^7.0.0"
    }
}
